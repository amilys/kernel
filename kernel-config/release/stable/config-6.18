# ==========================================
# ARM64
# ==========================================

CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_SMP=y

# ==========================================
# S905X3 / Amlogic
# ==========================================

CONFIG_ARCH_MESON=y

# ==========================================
# KEXEC
# ==========================================

CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y

# 不需要
# CONFIG_KEXEC_HANDOVER is not set

# ==========================================
# INITRAMFS
# ==========================================

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y

# ==========================================
# Device Tree
# ==========================================

CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y

# ==========================================
# Block
# ==========================================

CONFIG_BLOCK=y

# ==========================================
# USB
# ==========================================

CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ==========================================
# USB Keyboard
# ==========================================

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ==========================================
# MMC / eMMC
# ==========================================

CONFIG_MMC=y
CONFIG_MMC_MESON_GX=y

# ==========================================
# Filesystem
# ==========================================

CONFIG_EXT4_FS=y

CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# ==========================================
# Partition
# ==========================================

CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# ==========================================
# /dev
# ==========================================

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ==========================================
# proc/sys
# ==========================================

CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# ==========================================
# UART
# ==========================================

CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# ==========================================
# TTY
# ==========================================

CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ==========================================
# HDMI / DRM
# ==========================================

CONFIG_DRM=y
CONFIG_DRM_MESON=y
CONFIG_DRM_MESON_DW_HDMI=y
CONFIG_DRM_DW_HDMI=y

CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ==========================================
# I2C / GPIO / PINCTRL
# ==========================================

CONFIG_I2C=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_MESON=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MESON=y

# ==========================================
# Clock / Reset
# ==========================================

CONFIG_COMMON_CLK=y
#
# Clock support for Amlogic platforms
#
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_COMMON_CLK_MESON_DUALDIV=y
CONFIG_COMMON_CLK_MESON_MPLL=y
CONFIG_COMMON_CLK_MESON_PHASE=y
CONFIG_COMMON_CLK_MESON_PLL=y
CONFIG_COMMON_CLK_MESON_SCLK_DIV=y
CONFIG_COMMON_CLK_MESON_VID_PLL_DIV=y
CONFIG_COMMON_CLK_MESON_VCLK=y
CONFIG_COMMON_CLK_MESON_CLKC_UTILS=y
CONFIG_COMMON_CLK_MESON_AO_CLKC=y
CONFIG_COMMON_CLK_MESON_CPU_DYNDIV=y

CONFIG_COMMON_CLK_GXBB=y
CONFIG_COMMON_CLK_G12A=y

# CONFIG_COMMON_CLK_AXG is not set
# CONFIG_COMMON_CLK_AXG_AUDIO is not set
# CONFIG_COMMON_CLK_A1_PLL is not set
# CONFIG_COMMON_CLK_A1_PERIPHERALS is not set
# CONFIG_COMMON_CLK_C3_PLL is not set
# CONFIG_COMMON_CLK_C3_PERIPHERALS is not set
# CONFIG_COMMON_CLK_S4_PLL is not set
# CONFIG_COMMON_CLK_S4_PERIPHERALS is not set
# CONFIG_COMMON_CLK_T7_PLL is not set
# CONFIG_COMMON_CLK_T7_PERIPHERALS is not set

CONFIG_RESET_CONTROLLER=y

# ==========================================
# Network
# 第一版先保留
# ==========================================

CONFIG_NET=y
